.page { min-height: 100vh; background: var(--paper); padding-bottom: 60rpx; }

/* Hero */
.hero {
  background: var(--paper-page);
  border-bottom: 1rpx solid var(--rule);
  padding: 52rpx 40rpx 44rpx;
}
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.hero-eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.2;
  margin-bottom: 10rpx;
  font-family: var(--serif);
}
.hero-subtitle { display: block; font-size: 24rpx; color: var(--ink-faint); }

.settings-btn {
  padding: 16rpx;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 50%;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.settings-icon { font-size: 32rpx; }

/* Continue learning card */
.continue-card {
  display: flex;
  align-items: center;
  margin: 28rpx 36rpx 0;
  padding: 28rpx 32rpx;
  background: var(--paper-page);
  border: 1rpx solid var(--rule);
  border-left: 4rpx solid var(--accent);
  border-radius: 0 var(--radius) var(--radius) 0;
  gap: 16rpx;
}
.continue-body { flex: 1; min-width: 0; }
.continue-eyebrow {
  display: block;
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 6rpx;
}
.continue-kp-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.continue-ch-title {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
}
.continue-arrow { font-size: 40rpx; color: var(--ink-faint); flex-shrink: 0; }

/* Volume */
.volume-section { padding: 32rpx 40rpx 0; }
.volume-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-soft);
  letter-spacing: 0.06em;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--rule);
  margin-bottom: 8rpx;
}

/* Chapter list */
.chapter-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--rule);
  gap: 20rpx;
}
.chapter-row:last-child { border-bottom: none; }
.chapter-num-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--accent-pale);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.chapter-num { font-size: 24rpx; font-weight: 700; color: var(--accent); }
.chapter-info { flex: 1; min-width: 0; }
.chapter-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
  line-height: 1.4;
}
.chapter-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.chapter-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.chapter-status.sample-ready { background: #e8f5e9; color: #2e7d32; }
.chapter-status.draft { background: #fff9c4; color: #f57f17; }
.chapter-status.planned { background: #f3f3f3; color: #9e9e9e; }

.progress-tag {
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 600;
}

/* Progress bar */
.progress-bar-track {
  height: 6rpx;
  background: var(--rule);
  border-radius: 3rpx;
  overflow: hidden;
}
.progress-bar-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 3rpx;
  transition: width 0.3s;
}
.progress-bar-fill.complete { background: #2e7d32; }

.chapter-arrow { font-size: 40rpx; color: var(--ink-faint); flex-shrink: 0; }

.footer-note {
  margin: 56rpx 40rpx 0;
  padding: 18rpx 24rpx;
  background: var(--paper-page);
  border-radius: var(--radius);
  border: 1rpx solid var(--rule);
  text-align: center;
}
.footer-note text { font-size: 22rpx; color: var(--ink-faint); }
