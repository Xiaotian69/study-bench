.page { background: var(--paper); min-height: 100vh; padding: 32rpx 36rpx 80rpx; }

.section { margin-bottom: 40rpx; }
.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 16rpx;
}

/* Stats grid */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.stat-cell {
  background: var(--paper-page);
  border: 1rpx solid var(--rule);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  text-align: center;
}
.stat-val {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--accent);
  line-height: 1.1;
  margin-bottom: 8rpx;
  font-family: var(--serif);
}
.stat-lbl {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  font-weight: 500;
}

.card {
  background: var(--paper-page);
  border: 1rpx solid var(--rule);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 10rpx;
}
.field-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.key-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border: 1.5rpx solid var(--rule);
  border-radius: var(--radius);
  font-size: 26rpx;
  color: var(--ink);
  font-family: var(--mono);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.field-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.status-dot.active { background: #2e7d32; }
.status-dot.default { background: var(--ink-faint); }
.status-text { font-size: 24rpx; color: var(--ink-faint); }

.btn-row { display: flex; gap: 16rpx; }
.btn-row .btn { flex: 1; }

/* About */
.about-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--rule);
  align-items: flex-start;
  gap: 20rpx;
}
.about-row:last-child { border-bottom: none; }
.about-key { font-size: 26rpx; color: var(--ink-faint); flex-shrink: 0; }
.about-val { font-size: 26rpx; color: var(--ink); font-weight: 500; text-align: right; flex: 1; }

/* Tips */
.tips-card {}
.tip-text {
  display: block;
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.domain-chip {
  display: inline-block;
  font-family: var(--mono);
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-pale);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
