.page {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* Skip */
.skip-btn {
  position: absolute;
  top: 64rpx;
  right: 40rpx;
  z-index: 10;
  padding: 12rpx 24rpx;
}
.skip-text { font-size: 26rpx; color: var(--ink-faint); }

/* Swiper */
.swiper { flex: 1; width: 100%; min-height: 70vh; }

.slide {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 64rpx 60rpx;
  height: 100%;
  box-sizing: border-box;
}

.slide-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--accent-pale);
  border: 2rpx solid #f2d4cd;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}
.slide-icon {
  font-size: 72rpx;
  color: var(--accent);
  font-family: var(--serif);
  font-weight: 900;
  line-height: 1;
}

.slide-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: var(--ink);
  font-family: var(--serif);
  text-align: center;
  margin-bottom: 12rpx;
  line-height: 1.2;
}
.slide-subtitle {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  text-align: center;
  letter-spacing: 0.05em;
  margin-bottom: 36rpx;
}
.slide-body {
  display: block;
  font-size: 28rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.9;
  max-width: 540rpx;
}

/* Dots */
.dots {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  padding: 0 0 32rpx;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--rule);
  transition: all 0.3s;
}
.dot-active {
  background: var(--accent);
  width: 32rpx;
  border-radius: 7rpx;
}

/* CTA */
.cta-area {
  padding: 0 64rpx calc(60rpx + env(safe-area-inset-bottom));
}
.cta-btn {
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 32rpx;
  font-weight: 700;
}
.cta-next {
  background: var(--paper-page);
  border: 1.5rpx solid var(--rule);
  color: var(--ink);
}
.cta-start {
  background: var(--accent);
  color: #fff;
}

.bottom-rule {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: var(--rule);
}
