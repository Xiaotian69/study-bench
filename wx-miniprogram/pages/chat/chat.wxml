<view class="chat-page">
  <!-- Context strip -->
  <view class="context-strip" wx:if="{{kp}}">
    <text class="context-label">知识点：</text>
    <text class="context-kp">{{kpTitle}}</text>
    <text class="context-clear" bindtap="clearChat">重置</text>
  </view>

  <!-- Messages scroll area -->
  <scroll-view
    class="messages-area"
    scroll-y
    scroll-with-animation
    scroll-top="{{scrollTop}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="messages-inner">
      <view
        wx:for="{{messages}}"
        wx:key="{{index}}"
        class="msg-row {{item.role === 'user' ? 'is-user' : 'is-ai'}}"
      >
        <view wx:if="{{item.role === 'assistant'}}" class="avatar ai-avatar">
          <text>📚</text>
        </view>

        <view class="bubble-col {{item.role === 'user' ? 'bubble-col-user' : ''}}">
          <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <math-text
              text="{{item.content}}"
              size="normal"
              color="{{item.role === 'user' ? '#fff' : ''}}"
            />
          </view>
          <text wx:if="{{item.timeLabel}}" class="msg-time">{{item.timeLabel}}</text>
        </view>

        <view wx:if="{{item.role === 'user'}}" class="avatar user-avatar">
          <text>你</text>
        </view>
      </view>

      <!-- Typing indicator -->
      <view wx:if="{{sending}}" class="msg-row is-ai">
        <view class="avatar ai-avatar"><text>📚</text></view>
        <view class="bubble bubble-ai thinking">
          <text>思考中</text><text class="typing-dots">...</text>
        </view>
      </view>

      <!-- Error state with retry -->
      <view wx:if="{{hasError}}" class="error-row">
        <text class="error-msg">⚠ {{lastErrorMsg}}</text>
        <view class="retry-btn" bindtap="retryLastMessage"><text>重试</text></view>
      </view>

      <!-- Spacer so last message isn't hidden by input bar -->
      <view style="height:16rpx;" />
    </view>
  </scroll-view>

  <!-- Suggestion chips -->
  <view wx:if="{{showSuggestions && suggestions.length}}" class="suggestions-wrap">
    <scroll-view class="suggestions-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="suggestions-inner">
        <view
          wx:for="{{suggestions}}"
          wx:key="*this"
          class="suggestion-chip"
          bindtap="sendSuggestion"
          data-text="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Input area -->
  <view class="input-area">
    <textarea
      class="chat-input"
      placeholder="问一个问题…"
      value="{{inputText}}"
      bindinput="onInputChange"
      auto-height
      maxlength="500"
      confirm-type="send"
      bindconfirm="sendMessage"
      adjust-position
    />
    <button
      class="send-btn {{(!inputText || sending) ? 'is-disabled' : ''}}"
      bindtap="sendMessage"
      disabled="{{!inputText || sending}}"
    >发送</button>
  </view>
</view>
