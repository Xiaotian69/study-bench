.page { min-height: 100vh; background: var(--paper); padding-bottom: 60rpx; }

/* Chapter header */
.chapter-header {
  background: var(--paper-page);
  border-bottom: 1rpx solid var(--rule);
  padding: 48rpx 40rpx 36rpx;
}
.ch-eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.ch-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
  margin-bottom: 16rpx;
  font-family: var(--serif);
}
.ch-overview {
  background: var(--paper);
  border-left: 3rpx solid var(--accent);
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 0 var(--radius) var(--radius) 0;
}
.ch-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ch-meta { font-size: 24rpx; color: var(--ink-faint); }
.ch-studied { font-size: 24rpx; color: var(--accent); font-weight: 700; }
.ch-complete-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}
.ch-progress-bar-track {
  height: 6rpx;
  background: var(--rule);
  border-radius: 3rpx;
  overflow: hidden;
  margin-top: 14rpx;
}
.ch-progress-bar-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 3rpx;
  transition: width 0.4s;
}
.ch-progress-bar-fill.complete { background: #2e7d32; }

/* KP section */
.kp-section { padding: 32rpx 40rpx 0; }
.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--rule);
  margin-bottom: 8rpx;
}
.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-soft);
  letter-spacing: 0.06em;
}
.section-hint { font-size: 22rpx; color: var(--gold); font-weight: 600; }

/* KP list */
.kp-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--rule);
  gap: 20rpx;
}
.kp-row:last-child { border-bottom: none; }
.kp-row.is-studied .kp-title { color: var(--ink-soft); }

.kp-index-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  background: var(--accent-pale);
}
.kp-index { font-size: 22rpx; font-weight: 700; color: var(--accent); }
.kp-check { font-size: 26rpx; color: #2e7d32; font-weight: 900; }
.kp-row.is-studied .kp-index-wrap { background: #e8f5e9; }

.kp-info { flex: 1; min-width: 0; }
.kp-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.kp-goal-first {
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.5;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  display: block;
}
.kp-stats-row { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.kp-ex-count { font-size: 22rpx; color: var(--accent); font-weight: 600; }
.kp-ex-none { color: var(--ink-faint); }
.kp-diagram-count { font-size: 22rpx; color: var(--gold); font-weight: 700; }
.kp-score { font-size: 22rpx; font-weight: 700; }
.kp-score.good { color: #2e7d32; }
.kp-score.ok { color: #f57f17; }

.kp-arrow { font-size: 40rpx; color: var(--ink-faint); flex-shrink: 0; margin-top: 8rpx; }
